Primer Boceto Digital de nuestra app.
Este documento es de los primeros bocetos de nuestra app de manera digital.

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Control de Dron</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0a4d68, #088395, #05445e);
            color: #fff;
            overflow-x: hidden;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        header {
            text-align: center;
            padding: 20px 0;
            border-bottom: 2px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 30px;
        }

        h1 {
            font-size: 2.5em;
            font-weight: 300;
            letter-spacing: 2px;
            text-shadow: 0 0 20px rgba(0, 255, 255, 0.5);
        }

        .status-bar {
            display: flex;
            justify-content: space-around;
            margin-bottom: 30px;
            padding: 20px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            backdrop-filter: blur(10px);
        }

        .status-item {
            text-align: center;
        }

        .status-label {
            font-size: 0.9em;
            opacity: 0.7;
            margin-bottom: 5px;
        }

        .status-value {
            font-size: 1.5em;
            font-weight: bold;
            color: #00ff88;
        }

        .main-grid {
            display: grid;
            grid-template-columns: 1fr 2fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .panel {
            background: rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 25px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

        .panel h2 {
            font-size: 1.2em;
            margin-bottom: 20px;
            font-weight: 400;
            color: #00d4ff;
        }

        .video-feed {
            position: relative;
            background: #000;
            border-radius: 15px;
            overflow: hidden;
            aspect-ratio: 16/9;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #00ff88;
        }

        .video-placeholder {
            font-size: 1.2em;
            color: #666;
        }

        .crosshair {
            position: absolute;
            width: 40px;
            height: 40px;
            border: 2px solid #00ff88;
            border-radius: 50%;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        .crosshair::before,
        .crosshair::after {
            content: '';
            position: absolute;
            background: #00ff88;
        }

        .crosshair::before {
            width: 2px;
            height: 20px;
            left: 50%;
            top: -10px;
            transform: translateX(-50%);
        }

        .crosshair::after {
            width: 20px;
            height: 2px;
            top: 50%;
            left: -10px;
            transform: translateY(-50%);
        }

        .control-pad {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin: 20px 0;
        }

        .control-btn {
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.2), rgba(0, 255, 136, 0.2));
            border: 2px solid rgba(0, 212, 255, 0.5);
            color: #fff;
            padding: 20px;
            border-radius: 15px;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 1.2em;
        }

        .control-btn:hover {
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.4), rgba(0, 255, 136, 0.4));
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(0, 255, 136, 0.5);
        }

        .control-btn:active {
            transform: scale(0.95);
        }

        .control-btn.center {
            background: rgba(255, 0, 0, 0.3);
            border-color: rgba(255, 0, 0, 0.5);
        }

        .slider-control {
            margin: 20px 0;
        }

        .slider-control label {
            display: block;
            margin-bottom: 10px;
            font-size: 0.9em;
            opacity: 0.8;
        }

        input[type="range"] {
            width: 100%;
            height: 6px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 5px;
            outline: none;
        }

        input[type="range"]::-webkit-slider-thumb {
            appearance: none;
            width: 20px;
            height: 20px;
            background: #00ff88;
            border-radius: 50%;
            cursor: pointer;
            box-shadow: 0 0 10px rgba(0, 255, 136, 0.5);
        }

        .action-buttons {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 20px;
        }

        .action-btn {
            padding: 15px;
            border: none;
            border-radius: 12px;
            font-size: 1em;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 600;
        }

        .btn-takeoff {
            background: linear-gradient(135deg, #00ff88, #00d4ff);
            color: #000;
        }

        .btn-land {
            background: linear-gradient(135deg, #ff6b6b, #ff5252);
            color: #fff;
        }

        .btn-takeoff:hover, .btn-land:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
        }

        .telemetry-item {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .telemetry-label {
            opacity: 0.7;
        }

        .telemetry-value {
            color: #00ff88;
            font-weight: bold;
        }

        .map-container {
            background: rgba(0, 0, 0, 0.5);
            border-radius: 15px;
            height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 20px;
            border: 1px solid rgba(0, 212, 255, 0.3);
        }

        .battery-indicator {
            width: 100%;
            height: 30px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            overflow: hidden;
            position: relative;
            margin-top: 10px;
        }

        .battery-level {
            height: 100%;
            background: linear-gradient(90deg, #00ff88, #00d4ff);
            width: 75%;
            transition: width 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: #000;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .recording {
            animation: pulse 1.5s infinite;
        }

        @media (max-width: 1024px) {
            .main-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1> CONTROL DE DRON</h1>
        </header>

        <div class="status-bar">
            <div class="status-item">
                <div class="status-label">Estado</div>
                <div class="status-value">✓ CONECTADO</div>
            </div>
            <div class="status-item">
                <div class="status-label">GPS</div>
                <div class="status-value">12 SAT</div>
            </div>
            <div class="status-item">
                <div class="status-label">Señal</div>
                <div class="status-value">98%</div>
            </div>
            <div class="status-item">
                <div class="status-label">Batería</div>
                <div class="status-value">75%</div>
            </div>
        </div>

        <div class="main-grid">
            <div class="panel">
                <h2> Telemetría</h2>
                <div class="telemetry-item">
                    <span class="telemetry-label">Altitud</span>
                    <span class="telemetry-value">25.3 m</span>
                </div>
                <div class="telemetry-item">
                    <span class="telemetry-label">Velocidad</span>
                    <span class="telemetry-value">8.5 m/s</span>
                </div>
                <div class="telemetry-item">
                    <span class="telemetry-label">Distancia</span>
                    <span class="telemetry-value">142 m</span>
                </div>
                <div class="telemetry-item">
                    <span class="telemetry-label">Orientación</span>
                    <span class="telemetry-value">215°</span>
                </div>
                <div class="telemetry-item">
                    <span class="telemetry-label">Temperatura</span>
                    <span class="telemetry-value">28°C</span>
                </div>
                
                <h2 style="margin-top: 30px;"> Energía</h2>
                <div class="battery-indicator">
                    <div class="battery-level">75%</div>
                </div>
                <p style="text-align: center; margin-top: 10px; opacity: 0.7;">~18 min restantes</p>

                <div class="map-container">
                    <span style="opacity: 0.5;"> Mapa GPS</span>
                </div>
            </div>

            <div class="panel">
                <h2> Transmisión en Vivo</h2>
                <div class="video-feed">
                    <div class="video-placeholder"> Cámara FPV</div>
                    <div class="crosshair"></div>
                </div>

                <h2 style="margin-top: 30px;"> Controles de Vuelo</h2>
                <div class="control-pad">
                    <div></div>
                    <button class="control-btn">▲<br>Adelante</button>
                    <div></div>
                    <button class="control-btn">◄<br>Izq</button>
                    <button class="control-btn center">⊙<br>Stop</button>
                    <button class="control-btn">►<br>Der</button>
                    <div></div>
                    <button class="control-btn">▼<br>Atrás</button>
                    <div></div>
                </div>

                <div class="slider-control">
                    <label>⬆ Altitud</label>
                    <input type="range" min="0" max="100" value="50">
                </div>

                <div class="slider-control">
                    <label> Rotación</label>
                    <input type="range" min="-180" max="180" value="0">
                </div>
            </div>

            <div class="panel">
                <h2>Acciones Rápidas</h2>
                <div class="action-buttons">
                    <button class="action-btn btn-takeoff"> Despegar</button>
                    <button class="action-btn btn-land"> Aterrizar</button>
                </div>

                <h2 style="margin-top: 30px;"> Cámara</h2>
                <div class="action-buttons">
                    <button class="action-btn" style="background: #7c4dff; color: #fff;"> Foto</button>
                    <button class="action-btn recording" style="background: #ff1744; color: #fff;">⏺ Grabar</button>
                </div>

                <h2 style="margin-top: 30px;"> Modos de Vuelo</h2>
                <div class="action-buttons">
                    <button class="action-btn" style="background: #00bcd4; color: #fff;"> Normal</button>
                    <button class="action-btn" style="background: #ff9800; color: #fff;"> Sport</button>
                    <button class="action-btn" style="background: #4caf50; color: #fff;"> Estable</button>
                    <button class="action-btn" style="background: #9c27b0; color: #fff;"> Cine</button>
                </div>

                <h2 style="margin-top: 30px;"> Retorno</h2>
                <button class="action-btn" style="width: 100%; background: linear-gradient(135deg, #ffd700, #ff8c00); color: #000; font-size: 1.1em;">
                     Volver a Casa
                </button>

                <h2 style="margin-top: 30px;"> Configuración</h2>
                <div class="slider-control">
                    <label> Inclinación Cámara</label>
                    <input type="range" min="-90" max="30" value="0">
                </div>
                <div class="slider-control">
                    <label> Velocidad Máx</label>
                    <input type="range" min="1" max="20" value="10">
                </div>
            </div>
        </div>
    </div>
</body>
</html>
