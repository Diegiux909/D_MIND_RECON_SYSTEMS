Versión avanzada de la aplicación, incorporando todas las funcionalidades que deseamos cubrir en D-MIND RECON SYSTEMS.
Kimachang Luna Luis Ánel.

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="#081a2e"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="D-MIND RECON SYSTEMS"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#00d9ff"
                android:letterSpacing="0.2" />

            <TextView
                android:id="@+id/Estatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESTATUS: CONECTANDO..."
                android:textSize="12sp"
                android:textColor="#9CA3AF"
                android:fontFamily="monospace"
                android:layout_marginTop="8dp" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4"
            android:layout_marginBottom="16dp">


            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="#0D1F3D"
                app:cardElevation="8dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ESTADO"
                        android:textSize="10sp"
                        android:textColor="#9CA3AF"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvFlightStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EN TIERRA"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#00d9ff" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>



            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="#0D1F3D"
                app:cardElevation="8dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPS"
                        android:textSize="10sp"
                        android:textColor="#9CA3AF"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/GPS"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12 SAT"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#00d9ff" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>



            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="#0D1F3D"
                app:cardElevation="8dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SEÑAL"
                        android:textSize="10sp"
                        android:textColor="#9CA3AF"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/Señal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="98%"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#00d9ff" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>



            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="#0D1F3D"
                app:cardElevation="8dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MODO"
                        android:textSize="10sp"
                        android:textColor="#9CA3AF"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/Modo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estable"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#00d9ff" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                app:cardBackgroundColor="#0D1F3D"
                app:cardElevation="8dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TRANSMISIÓN FPV EN VIVO"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#00d9ff"
                        android:layout_marginBottom="12dp" />


                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:background="#000000">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Video Desconectado"
                            android:textColor="#9CA3AF"
                            android:layout_gravity="center" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="8dp"
                            android:layout_margin="8dp"
                            android:background="#80000000">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="60 FPS"
                                android:textSize="10sp"
                                android:textColor="#00d9ff"
                                android:fontFamily="monospace" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1920x1080"
                                android:textSize="10sp"
                                android:textColor="#00d9ff"
                                android:fontFamily="monospace" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                app:cardBackgroundColor="#0D1F3D"
                app:cardElevation="8dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONTROL DE MOVIMIENTO"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#00d9ff"
                        android:layout_marginBottom="12dp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="3"
                        android:rowCount="2"
                        android:alignmentMode="alignBounds"
                        android:useDefaultMargins="true">

                        <Button
                            android:id="@+id/btnAscend"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_columnWeight="1"
                            android:text="⬆\nAscender"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#1E40AF"
                            android:layout_margin="4dp" />

                        <Button
                            android:id="@+id/btnForward"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_columnWeight="1"
                            android:text="↑\nAdelante"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#1E40AF"
                            android:layout_margin="4dp" />

                        <Button
                            android:id="@+id/btnDescend"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_columnWeight="1"
                            android:text="⬇\nDescender"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#1E40AF"
                            android:layout_margin="4dp" />

                        
                        <Button
                            android:id="@+id/btnRotateLeft"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_columnWeight="1"
                            android:text="↶\nGirar Izq"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#1E40AF"
                            android:layout_margin="4dp" />

                        <Button
                            android:id="@+id/btnStop"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_columnWeight="1"
                            android:text="\nSTOP"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#991B1B"
                            android:layout_margin="4dp" />

                        <Button
                            android:id="@+id/btnRotateRight"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_columnWeight="1"
                            android:text="↷\nGirar Der"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#1E40AF"
                            android:layout_margin="4dp" />
                    </GridLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                app:cardBackgroundColor="#0D1F3D"
                app:cardElevation="8dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TELEMETRÍA DE VUELO"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#00d9ff"
                        android:layout_marginBottom="12dp" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:background="#0D243F"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Altitud"
                            android:textColor="#9CA3AF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/Altitud"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0m"
                            android:textColor="#00d9ff"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:background="#0D243F"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Velocidad"
                            android:textColor="#9CA3AF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/Velocidad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0 m/s"
                            android:textColor="#00d9ff"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:background="#0D243F"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Orientación"
                            android:textColor="#9CA3AF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/Orientacion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0°"
                            android:textColor="#00d9ff"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:background="#0D243F">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Temperatura"
                            android:textColor="#9CA3AF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/Temperatura"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="28°C"
                            android:textColor="#00d9ff"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BATERÍA"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#00d9ff"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp" />

                    <ProgressBar
                        android:id="@+id/Bateria"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:progress="75"
                        android:max="100"
                        android:progressTint="#2e7d32" />

                    <TextView
                        android:id="@+id/Bateria.info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiempo de vuelo estimado: 18 min"
                        android:textSize="12sp"
                        android:textColor="#9CA3AF"
                        android:layout_gravity="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                app:cardBackgroundColor="#0D1F3D"
                app:cardElevation="8dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACCIONES RÁPIDAS"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#00d9ff"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <Button
                            android:id="@+id/Despegar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="DESPEGAR"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#16A34A"
                            android:layout_margin="4dp"
                            android:padding="16dp" />

                        <Button
                            android:id="@+id/Regresar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="REGRESAR"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#7C3AED"
                            android:layout_margin="4dp"
                            android:padding="16dp" />
                    </LinearLayout>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CÁMARA Y GRABACIÓN"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#00d9ff"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <Button
                            android:id="@+id/Foto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="FOTO"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#CA8A04"
                            android:layout_margin="4dp"
                            android:padding="16dp" />

                        <Button
                            android:id="@+id/Grabar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="GRABAR"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#DC2626"
                            android:layout_margin="4dp"
                            android:padding="16dp" />
                    </LinearLayout>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONFIGURACIÓN"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#00d9ff"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Inclinación Cámara"
                            android:textColor="#9CA3AF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvCameraTilt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0°"
                            android:textColor="#00d9ff"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/sbCameraTilt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="120"
                        android:progress="90"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Velocidad Máxima"
                            android:textColor="#9CA3AF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/Velocidad_max"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10 m/s"
                            android:textColor="#00d9ff"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/Velocidad_max_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="25"
                        android:progress="10" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                app:cardBackgroundColor="#0D1F3D"
                app:cardElevation="8dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MODOS DE VUELO"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#00d9ff"
                        android:layout_marginBottom="12dp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2"
                        android:alignmentMode="alignBounds"
                        android:useDefaultMargins="true">

                        <Button
                            android:id="@+id/Normal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:text="Normal"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#3B82F6"
                            android:layout_margin="4dp" />

                        <Button
                            android:id="@+id/Sport"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:text="Sport"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#EAB308"
                            android:layout_margin="4dp" />

                        <Button
                            android:id="@+id/Estable"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:text="Estable"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#22C55E"
                            android:layout_margin="4dp" />

                        <Button
                            android:id="@+id/Cine"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:text="Cine"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#EC4899"
                            android:layout_margin="4dp" />
                    </GridLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
